  "item.minecraftdungeons.sacred_tablet": "Sacred Tablet",
  "item.minecraftdungeons.sacred_tablet.desc1": "An ancient stone tablet pulsing with power.",
  "item.minecraftdungeons.sacred_tablet.desc2": "Used to summon the boss rush (W.I.P)",
  "item.minecraftdungeons.tablet_of_sovereignty": "Tablet of Sovereignty (W.I.P)",
  "item.minecraftdungeons.tablet_of_sovereignty.desc1": "A Sacred Tablet overflowing with powerful energy",
  "item.minecraftdungeons.tablet_of_sovereignty.desc2": "Acquired from the Boss Rush",
  "item.minecraftdungeons.tablet_of_sovereignty.desc3": "Currently work-in-progress. Using this item as of version 1.0 may result in mass destruction.",
  "item.minecraftdungeons.redstone_medallion": "Redstone Medallion",
  "item.minecraftdungeons.redstone_medallion.desc1": "A medallion infused with redstone and destructive energy",
  "item.minecraftdungeons.redstone_medallion.desc2": "Right-Click to shoot a projectile that splits into 6 projectiles and summons a laser on impact.",
  "item.minecraftdungeons.soul_jar": "Soul Jar",
  "item.minecraftdungeons.soul_jar.desc1": "A jar beholding an immortal soul from the Nether",
  "item.minecraftdungeons.soul_jar.desc2": "Right-click to shoot 5 heavy-damage projectiles, or Shift+Right-click to either summon the Bound Necromancer or teleport an existing Bound Necromancer to your position.",
  "item.minecraftdungeons.corrupted_mace": "Corrupted Mace",
  "item.minecraftdungeons.corrupted_mace.desc1": "Was once a normal mace, is now infused with the corrupted energy of the Orb of Dominance. Only the corrupted can wield this without getting hurt.",
  "item.minecraftdungeons.corrupted_mace.desc2": "Is a melee weapon, dealing AOE damage on impact. Inflicts the enemy with corruption upon impact for 3 seconds, but due to its corrupt nature, it also inflicts corruption onto the wielder for 1 second.",
  "item.minecraftdungeons.obsidian_staff": "Obsidian Staff",
  "item.minecraftdungeons.obsidian_staff.desc1": "A magic staff made of pure obsidian, beholding a Nether Portal infused gemstone",
  "item.minecraftdungeons.obsidian_staff.desc2": "Right-click to shoot a projectile, or shift-right-click to summon Obsidian Bombs around you that leave behind harming clouds",
  "item.minecraftdungeons.relic_of_the_arch_illager": "Relic of the Arch-Illager",
  "item.minecraftdungeons.relic_of_the_arch_illager.desc1": "A stone relic infused with corrupted powers. Even though the Orb of Dominance shattered, staring at the runes makes it seem like it is still watching you.",
  "item.minecraftdungeons.relic_of_the_arch_illager.desc2": "Has 4 different modes. Right-clicking performs the attack, while Shift+Right-click changes modes. Mode 1 fires an outward ring of projectiles. Mode 2 summons a falling rain of projectiles. Mode 3 summons 4 spirals of Corrupted Fangs. Mode 4 summons a Corrupted Fang shockwave.",
  "item.minecraftdungeons.void_constructor": "Void Constructor (W.I.P.)",
  "item.minecraftdungeons.void_constructor.desc1": "An hourglass-like figure, beholding an eye surrounded in the void. You can feel the Heart of Ender's rage while holding it.",
  "item.minecraftdungeons.void_constructor.desc2": "Currently W.I.P.",
  "item.minecraftdungeons.blast_fungus": "Blast Fungus",
  "item.minecraftdungeons.blast_fungus.desc1": "It takes strong will to wield these fungi. Not just because they have toxic spores, but because their smell is horrible.",
  "item.minecraftdungeons.blast_fungus.desc2": "Throws 5 blast fungi into the air. They burst on impact, dealing area damage and leaving a poison cloud at the impact point.",
  "item.minecraftdungeons.scatter_mines": "Scatter Mines",
  "item.minecraftdungeons.scatter_mines.desc1": "The scatter mines are said to set your enemies up for the surprise of a lifetime. Simply put, you set them up to experience the big bang.",
  "item.minecraftdungeons.scatter_mines.desc2": "Used to summon 3 scatter mines around the player. One in front, one to the left, and one to the right.",
  "item.minecraftdungeons.cauldron_helmet": "Cauldron Helmet",
  "item.minecraftdungeons.cauldron_helmet.desc1": "A helmet made with the shards of the Corrupted Cauldron",
  "item.minecraftdungeons.cauldron_helmet.desc2": "Grants Regeneration. Can also summon Conjured Slimes to fight for you upon taking damage.",

  "item.minecraftdungeons.totem_of_regeneration": "Totem of Regeneration",
  "item.minecraftdungeons.totem_of_regeneration.desc1": "This hand-crafted wooden figurine radiates a warmth like that of campfire, healing those around it.",
  "item.minecraftdungeons.totem_of_regeneration.desc2": "Places down a wooden totem that creates a circular red aura, healing you and your allies.",

  "item.minecraftdungeons.death_cap_mushroom": "Death Cap Mushroom",
  "item.minecraftdungeons.death_cap_mushroom.desc1": "Eaten by daring warriors before battle, this mushroom drives fighters into a frenzy.",
  "item.minecraftdungeons.death_cap_mushroom.desc2": "Greatly increases both movement and attack speed when eaten.",

  "item.minecraftdungeons.mace": "Mace",
  "item.minecraftdungeons.mace.desc1": "A brutal tool of war. What it lacks in finesse, it makes up for in power.",
  "item.minecraftdungeons.mace.desc2": "Is a melee weapon. Deals AOE damage on impact.",

  "item.minecraftdungeons.glaive": "Glaive",
  "item.minecraftdungeons.glaive.desc1": "A weapon of style and power, it is a favorite among the servants of the Nameless One.",
  "item.minecraftdungeons.glaive.desc2": "Is a fast melee weapon.",
  "item.minecraftdungeons.venom_glaive": "Venom Glaive",
  "item.minecraftdungeons.venom_glaive.desc1": "A weapon of style, with a sharp blade surrounded by a toxic cloud that always seems to follow it. It is only used by the elite guard of the Nameless One.",
  "item.minecraftdungeons.venom_glaive.desc2": "Is a fast melee weapon. Poisons enemies that touch its blade.",

  "item.minecraftdungeons.prismatic_shell": "Prismatic Shell",
  "item.minecraftdungeons.prismatic_shell.desc1": "A sphere glowing in prismatic colors. It's colorful properties make it the only shell capable of storing many great powers inside without blowing up.",
  "item.minecraftdungeons.prismatic_shell.desc2": "Crafting Ingredient. Serves as the shell of the Sacred Core.",
  "item.minecraftdungeons.monstrous_core": "Monstrous Core",
  "item.minecraftdungeons.monstrous_core.desc1": "A stone pulsing with destructive powers. Rumors say that shattering one would demolish entire biomes.",
  "item.minecraftdungeons.monstrous_core.desc2": "Crafting Ingredient. Serves as the power source of the Sacred Core.",
  "item.minecraftdungeons.contained_void": "Contained Void",
  "item.minecraftdungeons.contained_void.desc1": "A container withholding the nothingness of the End.",
  "item.minecraftdungeons.contained_void.desc2": "Crafting Ingredient. Serves as the stabilizer of the Sacred Core.",
  "item.minecraftdungeons.monstrous_mushroom": "Monstrous Mushroom",
  "item.minecraftdungeons.monstrous_mushroom.desc1": "A large fungus acquired from the Mooshroom Monstrosity.",
  "item.minecraftdungeons.monstrous_mushroom.desc2": "Crafting Ingredient for the Monstrous Core.",
  "item.minecraftdungeons.monstrous_hand": "Monstrous Hand",
  "item.minecraftdungeons.monstrous_hand.desc1": "The oversized hand of the Redstone Monstrosity. Capable of smashing precious objects",
  "item.minecraftdungeons.monstrous_hand.desc2": "Crafting Ingredient for the Monstrous Core. Handle with care.",
  "item.minecraftdungeons.prismatic_reinforcement_plate": "Prismatic Reinforcement Plate",
  "item.minecraftdungeons.prismatic_reinforcement_plate.desc1": "A colorful reinforcement plate that has the strength of obsidian.",
  "item.minecraftdungeons.prismatic_reinforcement_plate.desc2": "Crafting Ingredient for the Prismatic Shell.",
  "item.minecraftdungeons.redstone_gem": "Redstone Gem",
  "item.minecraftdungeons.golden_gemstone": "Golden Gemstone",
  "item.minecraftdungeons.polished_emerald": "Polished Emerald",
  "item.minecraftdungeons.polished_diamond": "Polished Diamond",
  "item.minecraftdungeons.sacred_core": "Sacred Core",
  "item.minecraftdungeons.sacred_core.desc1": "A powerful core, pulsing with color and destruction. Smashing one might result in the end of the dimension, but harnessing it's power could bring great treasures.",
  "item.minecraftdungeons.sacred_core.desc2": "Crafting Ingredient for the Sacred Tablet.",

  "item.minecraftdungeons.blazing_orb": "Blazing Orb",
  "item.minecraftdungeons.blazing_orb.desc1": "A small orb burning with flames of destruction. Some wonder if the Redstone Golem's finger is the reason it lit up in the first place.",
  "item.minecraftdungeons.blazing_orb.desc2": "Crafting Ingredient for the Arch of Menace.",
  "item.minecraftdungeons.cauldron_ladle": "Cauldron Ladle",
  "item.minecraftdungeons.cauldron_ladle.desc1": "The ladle used by the Corrupted Cauldron to brew menacing beasts. Rumors say trying to brew a potion with it may result in resurrecting the Cauldron, or just a really nasty explosion.",
  "item.minecraftdungeons.cauldron_ladle.desc2": "Crafting Ingredient for the Arch of Menace. Is also a very basic whacker.",
  "item.minecraftdungeons.broken_staff_pieces": "Broken Staff Pieces",
  "item.minecraftdungeons.broken_staff_pieces.desc1": "Pieces of the Nameless One's staff, it now tries to reform itself. It has yet to be successful.",
  "item.minecraftdungeons.broken_staff_pieces.desc2": "Crafting Ingredient for the Arch of Menace.",
  "item.minecraftdungeons.corrupted_armor_shards": "Corrupted Armor Shards",
  "item.minecraftdungeons.corrupted_armor_shards.desc1": "Pieces of the armor worn by the Giant Royal Guard, it pulses with unstable energy. Thankfully, nobody's wearing this today.",
  "item.minecraftdungeons.corrupted_armor_shards.desc2": "Crafting Ingredient for the Arch of Menace.",
  "item.minecraftdungeons.arch_of_menace": "Arch of Menace",
  "item.minecraftdungeons.arch_of_menace.desc1": "A bent combination of materials. Some say it is haunted, and that if it broke, it would possess everything around it and tear the world apart.",
  "item.minecraftdungeons.arch_of_menace.desc2": "Crafting Ingredient for the Sacred Core.",
  "item.minecraftdungeons.energized_iron_bar": "Energized Iron Bar",
  "item.minecraftdungeons.energized_iron_bar.desc1": "An iron ingot infused with lightning, made of shards from the armor of Skeleton Horsemen.",
  "item.minecraftdungeons.energized_iron_bar.desc2": "Crafting Ingredient for the Blazing Orb.",
  "item.minecraftdungeons.crackling_bone": "Crackling Bone",
  "item.minecraftdungeons.crackling_bone.desc1": "A bone from a Skeleton Horseman, is said to call forth the horses from the thunderstorms.",
  "item.minecraftdungeons.crackling_bone.desc2": "Used to summon a Skeleton Horse before you.",
  "item.minecraftdungeons.electrified_reinforced_armor_shard": "Electrified Reinforced Armor Shard",
  "item.minecraftdungeons.electrified_reinforced_armor_shard.desc1": "The shard of a Skeleton Horseman's armor. Crackles with lightning.",
  "item.minecraftdungeons.electrified_reinforced_armor_shard.desc2": "Crafting Ingredient for the Energized Iron Bar.",
  "item.minecraftdungeons.charged_ender_pearl": "Charged Ender Pearl",
  "item.minecraftdungeons.charged_ender_pearl.desc1": "The ender pearl from a more powerful Enderman.",
  "item.minecraftdungeons.charged_ender_pearl.desc2": "Crafting Ingredient for the Blazing Orb. Can also be used to throw ender pearls, just at a durability cost.",
  "item.minecraftdungeons.redstone_golem_finger": "Redstone Golem Finger",
