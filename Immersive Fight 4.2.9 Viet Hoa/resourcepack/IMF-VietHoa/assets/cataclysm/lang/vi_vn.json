  "item.cataclysm.cursium_helmet.desc": "tầm nhìn ma quái",
  "item.cataclysm.cursium_helmet.desc2": "Nhấn [%s] để đánh dấu các thực thể phía sau bức tường trong phạm vi bằng hiệu ứng phát sáng",
  "item.cataclysm.cursium_chestplate.desc": "sự bất tử",
  "item.cataclysm.cursium_chestplate.desc2": "Sau khi chết, bạn sẽ ngay lập tức hồi phục 7 điểm máu và có được 5 giây bất khả chiến bại.",
  "item.cataclysm.cursium_chestplate.desc3": "Sau khi hồi sinh, người mặc sẽ bị suy yếu trong 6 phút và không thể hồi sinh trong thời gian suy yếu.",
  "item.cataclysm.cursium_leggings.desc": "Linh hồn né tránh",
  "item.cataclysm.cursium_leggings.desc2": "Có khả năng thấp để miễn nhiễm với sát thương nhận được lần này. Nếu đó là một cuộc tấn công bằng đạn, xác suất kích hoạt khả năng miễn dịch sẽ tăng lên.",
  "item.cataclysm.cursium_boots.desc": "Bàn chân ma quái",
  "item.cataclysm.cursium_boots.desc2": "Giảm sát thương khi rơi, nhấn [%s] để tắt khả năng này",
  "item.cataclysm.bulwark_of_the_flame.desc": "Ở trạng thái tàng hình, giữ tấm khiên này và nhấp chuột phải để lao về phía trước, gây sát thương cho thực thể phía trước.",
  "item.cataclysm.bulwark_of_the_flame2.desc": "Nếu mục tiêu va vào tường sau khi bị trúng đòn, mục tiêu sẽ nhận nhiều sát thương hơn và bị choáng tạm thời.",
  "item.cataclysm.incinerator.desc": "Nhấn và giữ nút phải của chuột trong 3 giây để sạc, sau đó nhả nút bên phải.",
  "item.cataclysm.incinerator2.desc": "để triệu tập một vụ nổ lửa theo hướng bạn đang đối mặt.",
  "item.cataclysm.incinerator3.desc": "Gây sát thương cho kẻ địch trong phạm vi",
  "item.cataclysm.cursed_bow.desc": "Bạn có thể bắn 3 mũi tên ma",
  "item.cataclysm.cursed_bow2.desc": "Nếu sử dụng mũi tên đặc biệt, cả hai mũi tên sẽ bị đốt cháy.",
  "item.cataclysm.annihilator.desc": "Sát thương chí mạng cao hơn",
  "item.cataclysm.annihilator2.desc": "Khi cầm một chiếc Búa chiến Annihilation khác ở tay trái, nhấp chuột phải để tích điện trong 2 giây để gây sát thương diện tích.",
  "item.cataclysm.soul_render.desc": "Nhấn chuột phải để nạp năng lượng và chạy nhanh, để lại một cây kích ma trên đường đi.",
  "item.cataclysm.soul_render2.desc": "Khi sử dụng khi đang lén lút, nó sẽ triệu hồi Phantom Halberd xung quanh nó.",
  "item.cataclysm.void_forge.desc": "Trong tay chính của bạn, bạn có thể nhấp chuột phải vào một khối để triệu hồi rune void hình quạt.",
  "item.cataclysm.void_forge.desc2": "(Đây vẫn là một cái cuốc)",
  "item.cataclysm.void_assault_shoulder_weapon.desc": "Nhấp chuột phải để phóng lựu đạn trống",
  "item.cataclysm.wither_assault_shoulder_weapon.desc": "Bạn có thể bắn tên lửa héo",
  "item.cataclysm.wither_assault_shoulder_weapon.desc2": "Nhấp chuột phải trong khi lén lút để phóng lựu đạn khô héo",
  "item.cataclysm.gauntlet_of_bulwark.desc": "Sau khi sạc được một giây, hãy đẩy các thực thể xung quanh ra xa và cho chúng hiệu ứng của Thuốc Thương Hiệu Lửa.",
  "item.cataclysm.gauntlet_of_bulwark.desc2": "Nếu bạn ngừng nhấp chuột phải, bạn sẽ lao về phía trước và gây sát thương cho các thực thể trước mặt bạn.",
  "item.cataclysm.ignitium_upgrade.desc": "nâng cấp Tengyan",
